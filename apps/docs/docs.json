{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "EmailUX Docs",
  "colors": {
    "primary": "#00AAAB",
    "light": "#E5F3F4",
    "dark": "#12474C"
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude"
    ]
  },
  "favicon": "/logo/favicon.png",
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/setup"
            ]
          },
          {
            "group": "Email Signatures",
            "pages": [
              "signatures/overview",
              "signatures/create-organization",
              "signatures/design-a-signature",
              "signatures/connect-google-workspace",
              "signatures/data-sources",
              "signatures/assignment-rules",
              "signatures/publish-to-gmail"
            ]
          },
          {
            "group": "Email Studio",
            "pages": [
              "email-studio/overview",
              "email-studio/design-your-first-email",
              "email-studio/localize-an-email",
              "email-studio/send-with-the-api",
              "guides/send-your-first-email"
            ]
          },
          {
            "group": "API",
            "pages": [
              "api/api-client"
            ]
          },
          {
            "group": "Providers",
            "pages": [
              "providers/overview",
              "providers/sendgrid",
              "providers/gmail",
              "providers/smtp-imap",
              "providers/api-keys"
            ]
          },
          {
            "group": "Add-Ins",
            "pages": [
              "addins/outlook-html-import",
              "addins/gmail-html-inserter"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "components/html",
              "components/head",
              "components/font",
              "components/css",
              "components/body",
              "components/button",
              "components/text",
              "components/a",
              "components/badge",
              "components/body-contents",
              "components/card",
              "components/hr",
              "components/img",
              "components/table",
              "components/box",
              "components/ul"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Components",
          "href": "https://docs.emailux.com/getting-started/setup",
          "icon": "grid-2-plus"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/iClasser/emailux",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#111111"
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/iClasser/emailux"
    },
    "links": [
      {
        "label": "EmailUX",
        "href": "https://www.emailux.com"
      }
    ]
  },
  "description": "Documentation for EmailUX: email signatures for Google Workspace, Email Studio, the email API client, React email components, and Gmail and Outlook HTML add-ins.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "EmailUX Docs",
      "og:type": "website",
      "twitter:card": "summary",
      "robots": "index, follow"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/iClasser/emailux",
      "x": "https://x.com/hmdroh",
      "website": "https://www.emailux.com"
    }
  }
}
