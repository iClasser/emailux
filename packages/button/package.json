{
  "name": "@emailux/button",
  "version": "1.2.0",
  "description": "Display a button in your email (EmailUX Mailer)",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --external react",
    "build:watch": "tsdown src/index.ts --format esm,cjs --dts --external react --watch",
    "dev": "pnpm run build:watch",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iClasser/emailux",
    "directory": "packages/button"
  },
  "keywords": [
    "react",
    "email",
    "email-notification",
    "button",
    "react-email-component",
    "react-email",
    "send-email",
    "email-component",
    "emailux-mailer",
    "emailux-email-comps",
    "emailux"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@emailux/html": "workspace:*"
  },
  "devDependencies": {
    "tsconfig": "workspace:^0.1.0",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
