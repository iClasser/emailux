{
  "name": "@emailux/api-client",
  "version": "1.0.0",
  "description": "EmailUX API (EmailUX Render and Delivery)",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --clean",
    "build:watch": "tsdown src/index.ts --format esm,cjs --dts --external react --watch",
    "dev": "tsup src/index.ts --watch --dts --format esm,cjs --out-dir dist",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
    "test": "vitest run",
    "release:dry-run": "npm pack --dry-run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iClasser/emailux",
    "directory": "packages/api-client"
  },
  "keywords": [
    "react",
    "email",
    "email-notification",
    "react-email-component",
    "react-email",
    "send-email",
    "email-component",
    "emailux-api",
    "api-client",
    "emailux-render",
    "emailux-delivery",
    "emailux"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsconfig": "workspace:^0.1.0",
    "typescript": "5.8.3",
    "tsup": "^8.3.0",
    "rimraf": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
