{
  "name": "@emailux/components",
  "version": "1.2.0",
  "description": "All EmailUX email components in one package",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --external react",
    "build:watch": "tsdown src/index.ts --format esm,cjs --dts --watch",
    "dev": "pnpm run build:watch",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iClasser/emailux",
    "directory": "packages/components"
  },
  "keywords": [
    "react",
    "email",
    "emailux",
    "email-components",
    "email-notification",
    "react-email-components",
    "react-email",
    "send-email",
    "email-component",
    "emailux-mailer",
    "emailux-email-comps"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "tsconfig": "workspace:*"
  },
  "dependencies": {
    "@emailux/a": "workspace:^1.2.0",
    "@emailux/api-client": "workspace:^2.1.0",
    "@emailux/badge": "workspace:^1.2.0",
    "@emailux/body": "workspace:^1.2.0",
    "@emailux/body-contents": "workspace:^1.2.0",
    "@emailux/box": "workspace:^1.2.0",
    "@emailux/button": "workspace:^1.2.0",
    "@emailux/card": "workspace:^1.2.0",
    "@emailux/css": "workspace:^1.2.0",
    "@emailux/font": "workspace:^1.2.0",
    "@emailux/get-html": "workspace:^1.2.0",
    "@emailux/get-text": "workspace:^1.2.0",
    "@emailux/head": "workspace:^1.2.0",
    "@emailux/html": "workspace:^1.2.0",
    "@emailux/hr": "workspace:^1.2.0",
    "@emailux/img": "workspace:^1.2.0",
    "@emailux/li": "workspace:^1.2.0",
    "@emailux/ol": "workspace:^1.2.0",
    "@emailux/table": "workspace:^1.2.0",
    "@emailux/text": "workspace:^1.2.0",
    "@emailux/ul": "workspace:^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
